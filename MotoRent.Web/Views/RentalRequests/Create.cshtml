@model MotoRent.Web.Models.CreateRentalRequestViewModel

@{
    ViewData["Title"] = "Заяви наем";
    var listingId = ViewData["ListingId"];
    var listingTitle = ViewData["ListingTitle"];
}

<h1 class="my-4">@ViewData["Title"]</h1>
<p class="fw-semibold">@listingTitle</p>

<form asp-controller="RentalRequests"
      asp-action="Create"
      asp-route-id="@listingId"
      method="post"
      class="col-lg-7">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Изпрати заявката</button>

    <a asp-controller="RentalListings"
       asp-action="Details"
       asp-route-id="@listingId"
       class="btn btn-outline-secondary">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}