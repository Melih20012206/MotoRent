@model IReadOnlyList<MotoRent.Web.Models.RentalRequest>

@{
    ViewData["Title"] = "Получени заявки";
}

<h1 class="my-4">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}

@if (Model.Count == 0)
{
    <p>Все още няма получени заявки за твоите обяви.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Мотор</th>
                    <th scope="col">Начална дата</th>
                    <th scope="col">Крайна дата</th>
                    <th scope="col">Статус</th>
                    <th scope="col">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    var status = request.Status switch
                    {
                        MotoRent.Web.Models.RentalRequestStatus.Pending => "Чака отговор",
                        MotoRent.Web.Models.RentalRequestStatus.Accepted => "Приета",
                        MotoRent.Web.Models.RentalRequestStatus.Rejected => "Отказана",
                        _ => "Неизвестен статус"
                    };

                    <tr>
                        <td>
                            <a asp-controller="RentalListings"
                               asp-action="Details"
                               asp-route-id="@request.RentalListingId">
                                @request.RentalListing.Make @request.RentalListing.Model
                            </a>
                        </td>
                        <td>@request.StartDate.ToString("dd.MM.yyyy")</td>
                        <td>@request.EndDate.ToString("dd.MM.yyyy")</td>
                        <td>@status</td>
                        <td>
                            @if (request.Status == MotoRent.Web.Models.RentalRequestStatus.Pending)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    <form asp-controller="RentalRequests"
                                          asp-action="Accept"
                                          asp-route-id="@request.Id"
                                          method="post">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            Приеми
                                        </button>
                                    </form>

                                    <form asp-controller="RentalRequests"
                                          asp-action="Reject"
                                          asp-route-id="@request.Id"
                                          method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Откажи
                                        </button>
                                    </form>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}