@model IReadOnlyList<MotoRent.Web.Models.RentalListing>

@{
    ViewData["Title"] = "Мотори под наем";

    var search = ViewData["Search"] as string;
    var sort = ViewData["Sort"] as string ?? "newest";
    var category = ViewData["Category"] as MotoRent.Web.Models.MotorcycleCategory?;
    var categories = Html.GetEnumSelectList<MotoRent.Web.Models.MotorcycleCategory>();
    var selectedCategoryValue = category.HasValue
        ? ((int)category.Value).ToString()
        : "";
}

<h1 class="my-4">@ViewData["Title"]</h1>

@if (User.Identity?.IsAuthenticated == true)
{
    <a asp-action="Mine" class="btn btn-outline-primary mb-3">Моите обяви</a>
}

<form asp-action="Index" method="get" class="mb-4">
    <div class="d-flex flex-wrap align-items-end gap-2">
        <div>
            <label for="search" class="form-label">Марка, модел или град</label>
            <input id="search"
                   name="search"
                   type="search"
                   value="@search"
                   class="form-control" />
        </div>

        <div>
            <label for="category" class="form-label">Категория</label>
            <select id="category" name="category" class="form-select">
                <option value="">Всички категории</option>
                @foreach (var item in categories)
                {
                    <option value="@item.Value"
                            selected="@(item.Value == selectedCategoryValue)">
                        @item.Text
                    </option>
                }
            </select>
        </div>

        <div>
            <label for="sort" class="form-label">Подреди по</label>
            <select id="sort" name="sort" class="form-select">
                <option value="newest" selected="@(sort == "newest")">Най-нови</option>
                <option value="price-asc" selected="@(sort == "price-asc")">
                    Цена – от ниска към висока
                </option>
                <option value="price-desc" selected="@(sort == "price-desc")">
                    Цена – от висока към ниска
                </option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Покажи</button>

        @if (!string.IsNullOrEmpty(search) || category.HasValue || sort != "newest")
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <p>
        @(string.IsNullOrEmpty(search) && !category.HasValue
            ? "Все още няма публикувани обяви."
            : "Няма обяви по избраните критерии.")
</p>
}
else
{
    <div class="row g-3">
        @foreach (var listing in Model)
        {
            <div class="col-sm-6 col-lg-4">
                <article class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">@listing.Make @listing.Model</h2>
                        <p class="text-muted mb-2">@listing.City</p>
                        <p class="fw-bold mb-0">@listing.DailyPrice.ToString("0.00") € / ден</p>

                        <a asp-action="Details"
                           asp-route-id="@listing.Id"
                           class="btn btn-outline-primary mt-3">Виж обявата</a>
                    </div>
                </article>
            </div>
        }
    </div>
}