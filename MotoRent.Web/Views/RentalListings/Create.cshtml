@model MotoRent.Web.Models.CreateRentalListingViewModel

@{
    ViewData["Title"] = "Публикувай мотор";
}

<h1 class="my-4">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<form asp-action="Create" method="post" class="col-lg-7">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @if (ViewData["NeedsDateOfBirth"] is true)
    {
        <div class="mb-3">
            <label asp-for="DateOfBirth" class="form-label"></label>
            <input asp-for="DateOfBirth" type="date" class="form-control"
                   aria-describedby="date-of-birth-help" required />
            <div id="date-of-birth-help" class="form-text">
                За да публикуваш обява, трябва да имаш навършени 18 години.
                Датата се запазва в профила ти и не се показва в обявата.
            </div>
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Make" class="form-label"></label>
        <input asp-for="Make" class="form-control" />
        <span asp-validation-for="Make" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category"
                asp-items="Html.GetEnumSelectList<MotoRent.Web.Models.MotorcycleCategory>()"
                class="form-select">
            <option value="">Избери категория</option>
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DailyPrice" class="form-label"></label>
        <input asp-for="DailyPrice" type="number" min="1" max="10000"
               step="0.01" class="form-control" />
        <span asp-validation-for="DailyPrice" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="5" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Публикувай обявата</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}