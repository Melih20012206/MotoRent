@model IReadOnlyList<MotoRent.Web.Models.RentalListing>

@{
    ViewData["Title"] = "Моите обяви";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 my-4">
    <h1 class="mb-0">@ViewData["Title"]</h1>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-warning" role="alert">@errorMessage</div>
    }

    <a asp-controller="RentalRequests"
       asp-action="Incoming"
       class="btn btn-outline-primary mb-3">Получени заявки</a>
    <a asp-action="Create" class="btn btn-primary">Публикувай мотор</a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

@if (Model.Count == 0)
{
    <p>Все още нямаш публикувани обяви.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Мотор</th>
                    <th scope="col">Град</th>
                    <th scope="col">Цена на ден</th>
                    <th scope="col"><span class="visually-hidden">Действия</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var listing in Model)
                {
                    <tr>
                        <td>@listing.Make @listing.Model</td>
                        <td>@listing.City</td>
                        <td>@listing.DailyPrice.ToString("0.00") €</td>
                        <td class="text-end">
                            <a asp-action="Edit"
                               asp-route-id="@listing.Id"
                               class="btn btn-sm btn-outline-secondary">Редактирай</a>
                            <a asp-action="Details"
                               asp-route-id="@listing.Id"
                               class="btn btn-sm btn-outline-primary">Виж обявата</a>
                            <a asp-action="Delete"
                               asp-route-id="@listing.Id"
                               class="btn btn-sm btn-outline-danger">Изтрий</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary">Към каталога</a>