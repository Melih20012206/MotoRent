@model RentalListingDetailsViewModel

@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager

@{
    var listing = Model.Listing;
    ViewData["Title"] = $"{listing.Make} {listing.Model}";

    var categoryName = listing.Category is { } category
        ? Html.GetEnumSelectList<MotorcycleCategory>()
            .FirstOrDefault(item => item.Value == ((int)category).ToString())?.Text
        : null;
}

<h1 class="my-4">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}

<p class="text-muted">@listing.City</p>
<p>Категория: @(categoryName ?? "Без категория")</p>
<p class="fw-bold">@listing.DailyPrice.ToString("0.00") € / ден</p>

<h2 class="h5">Описание</h2>
<p style="white-space: pre-wrap">@listing.Description</p>

<section class="my-4" aria-labelledby="availability-heading">
    <h2 id="availability-heading" class="h5">Наличност за следващите 30 дни</h2>

    <ul class="list-unstyled row row-cols-2 row-cols-sm-4 row-cols-lg-6 g-2">
        @foreach (var day in Model.Availability)
        {
            <li class="col">
                <div class="border rounded p-2">
                    <time datetime="@day.Date.ToString("yyyy-MM-dd")"
                          class="d-block fw-semibold">
                        @day.Date.ToString("dd.MM.yyyy")
                    </time>
                    <span class="badge @(day.IsBooked ? "bg-danger" : "bg-success")">
                        @(day.IsBooked ? "Зает" : "Свободен")
                    </span>
                </div>
            </li>
        }
    </ul>
</section>

@if (UserManager.GetUserId(User) != listing.OwnerId)
{
    <a asp-controller="RentalRequests"
       asp-action="Create"
       asp-route-id="@listing.Id"
       class="btn btn-primary">Заяви наем</a>
}

@if (User.Identity?.IsAuthenticated == true)
{
    var isFavorite = ViewData["IsFavorite"] is true;

    <form asp-area=""
          asp-controller="Favorites"
          asp-action="@(isFavorite ? "Remove" : "Add")"
          asp-route-id="@listing.Id"
          method="post"
          class="d-inline">
        <button type="submit" class="btn btn-outline-danger">
            @(isFavorite ? "♥ Премахни от любими" : "♡ Добави в любими")
        </button>
    </form>
}
else
{
    <a asp-area="Identity"
       asp-page="/Account/Login"
       asp-route-returnUrl="@Url.Action("Details", "RentalListings", new { id = listing.Id })"
       class="btn btn-outline-danger">♡ Добави в любими</a>
}