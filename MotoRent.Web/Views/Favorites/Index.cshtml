@model IReadOnlyList<RentalListing>

@{
    ViewData["Title"] = "Моите любими";
}

<h1 class="my-4">@ViewData["Title"]</h1>

@if (Model.Count == 0)
{
    <p>Все още нямаш запазени обяви.</p>
    <a asp-controller="RentalListings" asp-action="Index">Разгледай обявите</a>
}
else
{
    <ul class="list-group">
        @foreach (var listing in Model)
        {
            <li class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <a asp-controller="RentalListings"
                       asp-action="Details"
                       asp-route-id="@listing.Id"
                       class="fw-bold">@listing.Make @listing.Model</a>
                    <div>@listing.City · @listing.DailyPrice.ToString("0.00") € / ден</div>
                </div>

                <form asp-action="Remove" asp-route-id="@listing.Id" method="post">
                    <input type="hidden" name="fromFavorites" value="true" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        Премахни
                    </button>
                </form>
            </li>
        }
    </ul>
}